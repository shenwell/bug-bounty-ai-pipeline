# Portfolio (Phase 1) — copy to config/.env.portfolio or repo .env

# LLM (optional; default provider=stub in config/portfolio.yaml)
LLM_API_KEY=

# Standoff365 auth (cookie preferred — password login hits SmartCaptcha in headless)
STF_SESSION=
STF_USERNAME=
STF_PASSWORD=

# Telegram notifications (portfolio monitor)
TG_BOT_TOKEN=
TG_CHAT_ID=

# Database (optional; audit is no-op when DATABASE_URL unset)
DATABASE_URL=sqlite:///data/portfolio.db

# Bug bounty traffic header (per-program override in constraints)
BUG_BOUNTY_USER=your-username

# Standoff365 program-specific headers
FEDSFM_X_BUGBOUNTY=

# New-program monitor email (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
MONITOR_NOTIFY_EMAIL=
